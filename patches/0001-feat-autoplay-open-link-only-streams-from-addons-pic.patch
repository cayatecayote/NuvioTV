From 2717e95cbadeb241b373f64edb75e8270ec44641 Mon Sep 17 00:00:00 2001
From: cayatecayote <juanemain@gmail.com>
Date: Sat, 31 Oct 2026 14:19:20 -0300
Subject: [PATCH 1/3] feat(autoplay): open link-only streams from addons picked
 for autoplay

Addons such as WatchHub answer only with externalUrl links that open the
title in another app or site. The autoplay selector always skipped them,
so picking WatchHub as the autoplay addon left the stream list on screen
instead of opening the link.

A link-only stream is now an autoplay candidate when the user selected
its addon by name in the autoplay addon list, and only for http(s)
links, so error placeholders such as stremio:/// never open by
themselves. With the default "all addons" selection nothing changes.
The autoplay launcher opens it through the same external path a manual
tap uses.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../tv/core/player/StreamAutoPlaySelector.kt  | 20 ++++-
 .../core/player/StreamAutoPlaySelectorTest.kt | 89 +++++++++++++++++++
 2 files changed, 106 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/com/nuvio/tv/core/player/StreamAutoPlaySelector.kt b/app/src/main/java/com/nuvio/tv/core/player/StreamAutoPlaySelector.kt
index 007910408..0bbe3c6da 100644
--- a/app/src/main/java/com/nuvio/tv/core/player/StreamAutoPlaySelector.kt
+++ b/app/src/main/java/com/nuvio/tv/core/player/StreamAutoPlaySelector.kt
@@ -57,6 +57,20 @@ object StreamAutoPlaySelector {
             (AppFeaturePolicy.inAppTrailerPlaybackEnabled && stream.youTubeIdToResolve() != null)
     }
 
+    /**
+     * Link-only addons (e.g. WatchHub) answer with web links that open the title in another
+     * app. They autoplay only when the user picked that addon by name for autoplay, and only
+     * for http(s) links, so placeholders like `stremio:///` never get opened on their own.
+     */
+    private fun isOptedInExternalLink(stream: Stream, selectedAddons: Set<String>): Boolean {
+        if (!stream.isExternal() || stream.addonName !in selectedAddons) return false
+        val link = stream.externalUrl?.trim().orEmpty()
+        return link.startsWith("https://", ignoreCase = true) || link.startsWith("http://", ignoreCase = true)
+    }
+
+    private fun isAutoPlayCandidate(stream: Stream, selectedAddons: Set<String>): Boolean =
+        isPlayable(stream) || isOptedInExternalLink(stream, selectedAddons)
+
     /**
      * Exact binge group for addons. For a local plugin, the stream whose identity tokens
      * still match after the next episode's own shared words are removed.
@@ -151,7 +165,7 @@ object StreamAutoPlaySelector {
 
         return when (mode) {
             StreamAutoPlayMode.MANUAL -> null
-            StreamAutoPlayMode.FIRST_STREAM -> candidateStreams.firstOrNull { isPlayable(it) }
+            StreamAutoPlayMode.FIRST_STREAM -> candidateStreams.firstOrNull { isAutoPlayCandidate(it, selectedAddons) }
             StreamAutoPlayMode.REGEX_MATCH -> {
                 val pattern = regexPattern.trim()
 
@@ -174,7 +188,7 @@ object StreamAutoPlaySelector {
 
                 // 1. Build list of ALL regex‑matching streams
                 val matchingStreams = candidateStreams.filter { stream ->
-                    if (!isPlayable(stream)) return@filter false
+                    if (!isAutoPlayCandidate(stream, selectedAddons)) return@filter false
 
                     val searchableText = buildString {
                         append(stream.addonName).append(' ')
@@ -197,7 +211,7 @@ object StreamAutoPlaySelector {
                 }
 
                 if (matchingStreams.isEmpty()) return null
-                matchingStreams.firstOrNull { isPlayable(it) }
+                matchingStreams.firstOrNull()
             }
 
         }
